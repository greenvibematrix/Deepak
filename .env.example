# ==============================================================================
# SAYANDANA'S BIRTHDAY WEBSITE - BACKEND CONFIGURATION
# ==============================================================================

# Required: The email address where Sayandana's 3 wishes will be delivered
OWNER_EMAIL=greenvibematrix@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: Direct Gmail Delivery (Recommended & Free)
# ------------------------------------------------------------------------------
# 1. Log into your Google Account (e.g. greenvibematrix@gmail.com)
# 2. Go to: Security -> 2-Step Verification -> App Passwords
# 3. Create an app password named "Birthday Website"
# 4. Paste your 16-character code below (spaces are automatically stripped):
GMAIL_USER=greenvibematrix@gmail.com
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# OPTION 2: Resend API (Best for Vercel / Cloud Serverless)
# ------------------------------------------------------------------------------
# Sign up for free at https://resend.com (3,000 free emails/month)
# Create an API Key in your dashboard and paste it here:
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# OPTION 3: Custom SMTP (Optional)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# LOCAL SERVER PORT
# ------------------------------------------------------------------------------
PORT=3000
